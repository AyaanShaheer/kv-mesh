      "dot": "cyan",
      "title": "Heterogeneous Tiered Memory",
      "items": [
        "Tier 1 (GPU VRAM): Fast access for active generation sequence blocks",
        "Tier 2 (Host CPU RAM): C++ pybind11 pool manages evicted tensors",
        "Automatic PCIe prefetch on cache recall prevents complete cache evictions"
      ]
    },
